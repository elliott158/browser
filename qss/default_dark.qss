QMainWindow, QWidget {
    background: #202124;
    color: #f1f3f4;
}
QToolBar, QMenuBar, QMenu {
    background: #292a2d;
    color: #f1f3f4;
}
QLineEdit {
    background: #35363a;
    color: #f1f3f4;
    border: 1px solid #5f6368;
    padding: 5px;
}
QPushButton {
    background: #35363a;
    color: #f1f3f4;
    border: 1px solid #5f6368;
    padding: 5px 10px;
}